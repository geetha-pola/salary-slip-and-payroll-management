<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.payroll.controller.MainLayoutController">

    <!-- Persistent Navy Blue Sidebar -->
    <left>
        <VBox fx:id="sidebarBox" spacing="0" prefWidth="255">
            <!-- Sidebar Header Brand -->
            <VBox spacing="4">
                <padding>
                    <Insets top="24" right="20" bottom="24" left="20"/>
                </padding>
                <Label fx:id="brandTitleLabel" text="PAYROLL PORTAL"/>
                <Label fx:id="brandSubtitleLabel" text="Enterprise Edition (PS-10)"/>
            </VBox>

            <!-- Navigation Links -->
            <VBox fx:id="navLinksBox" spacing="4" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="10" right="12" bottom="10" left="12"/>
                </padding>
                <Button fx:id="btnDashboard" text="📊  Dashboard" onAction="#showDashboard" maxWidth="Infinity"/>
                <Button fx:id="btnRegistration" text="👤  Employee Registration" onAction="#showRegistration" maxWidth="Infinity"/>
                <Button fx:id="btnDirectory" text="📁  Employee Directory" onAction="#showDirectory" maxWidth="Infinity"/>
                <Button fx:id="btnSettings" text="⚙️  Salary Policy Settings" onAction="#showSettings" maxWidth="Infinity"/>
                <Button fx:id="btnPayroll" text="💰  Monthly Payroll Processing" onAction="#showPayroll" maxWidth="Infinity"/>
                <Button fx:id="btnSalarySlip" text="📄  Salary Slip Generation" onAction="#showSalarySlip" maxWidth="Infinity"/>
                <Button fx:id="btnHistory" text="📜  Payroll History" onAction="#showHistory" maxWidth="Infinity"/>
            </VBox>

            <!-- Sidebar User & Logout Footer -->
            <VBox spacing="10">
                <padding>
                    <Insets top="16" right="16" bottom="20" left="16"/>
                </padding>
                <Label fx:id="userLabel" text="Admin: 1234"/>
                <Button fx:id="btnLogout" text="🚪  Sign Out" onAction="#handleLogout" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>

    <!-- Dynamic Central Content Area -->
    <center>
        <StackPane fx:id="contentArea">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>
